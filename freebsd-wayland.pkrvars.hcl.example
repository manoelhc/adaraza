# FreeBSD Wayland Image Variables
# Copy this file to freebsd-wayland.auto.pkrvars.hcl and customize as needed

# FreeBSD version to build
# freebsd_version = "14.1"

# Architecture (amd64, arm64, etc.)
# freebsd_arch = "amd64"

# Custom ISO URL (optional)
# iso_url = "https://download.freebsd.org/releases/amd64/amd64/ISO-IMAGES/14.1/FreeBSD-14.1-RELEASE-amd64-disc1.iso"

# ISO checksum (required if custom ISO URL is used)
# Get from: https://download.freebsd.org/releases/amd64/amd64/ISO-IMAGES/14.1/CHECKSUM.SHA256-FreeBSD-14.1-RELEASE-amd64
# iso_checksum = "sha256:YOUR_CHECKSUM_HERE"

# Disk size in MB (default: 40GB)
# disk_size = "40960"

# Memory in MB (default: 4GB)
# memory = "4096"

# Number of CPUs (default: 2)
# cpus = "2"

# Output directory for the built image
# output_directory = "output-freebsd-wayland"
